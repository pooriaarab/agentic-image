{
  "author": "Pooria Arab",
  "bin": {
    "agentic-image": "./dist/cli.js",
    "agentic-image-mcp": "./dist/mcp-bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "description": "Generate images with Flux, Ideogram, Replicate, and Cloudflare Workers AI through a TypeScript SDK, CLI, and MCP server.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "image-generation",
    "text-to-image",
    "flux",
    "black-forest-labs",
    "ideogram",
    "replicate",
    "cloudflare",
    "workers-ai",
    "typescript",
    "cli",
    "mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "mcpName": "io.github.pooriaarab/agentic-image",
  "name": "agentic-image",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-image.git"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
